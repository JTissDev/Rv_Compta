<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="logs" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="BANNER_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-compta.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/app-compta.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %replace(%msg){'\u001B\[[;0-9]*m',''}%n</pattern>
        </encoder>
    </appender>

    <appender name="TEST_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/test-verite.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %replace(%msg){'\u001B\[[;0-9]*m',''}%n</pattern>
        </encoder>
    </appender>


    <springProfile name="test">
        <logger name="com.jtissdev_API" level="TRACE" additivity="false">
            <appender-ref ref="TEST_FILE" />
            <appender-ref ref="CONSOLE" />
        </logger>
    </springProfile>

    <springProfile name="console">
        <logger name="com.jtissdev_API" level="INFO" />
    </springProfile>

    <logger name="c.jtissdev.logging.banner.AppBanner" level="INFO" additivity="false">
        <appender-ref ref="BANNER_CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="org.springframework" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>